# Copy to secrets-dev-local.yaml (gitignored) and apply for local cluster dev secrets.
apiVersion: v1
kind: Secret
metadata:
  name: api-gateway-secrets
  namespace: saloon-system
type: Opaque
stringData:
  JWT_SECRET: "replace-with-a-strong-local-dev-secret"
  DB_PASSWORD: "root"
  REDIS_PASSWORD: ""
